# Public configuration, embedded at build time. Empty ID disables analytics.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Exact hostnames, comma separated. Production: your public domain only.
VITE_UMAMI_DOMAINS=
# Local testing requires a SEPARATE Umami website and localhost in DOMAINS.
VITE_UMAMI_ALLOW_DEV=false
